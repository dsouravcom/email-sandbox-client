# Copy this to .env (never commit .env itself) and fill in values for this
# machine. Read once at `npm start`/`npm run build` time — see
# scripts/generate-runtime-config.mjs. Because .env isn't tracked by git, a
# production checkout keeps whatever you set here across every future
# `git pull` + rebuild; you only ever set it once per machine.

# Port the Angular dev server listens on. Only used by `npm start`.
PORT=4200

# Where the NestJS API lives, from this machine's point of view. Point this
# at your local backend in development, and at the real API's public URL in
# production (e.g. https://api.email.dsourav.com/api).
API_BASE_URL=http://localhost:3000/api
